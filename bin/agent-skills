#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
import os
import sys

if sys.version_info < (3, 11):
    import shutil

    # A host can put /usr/bin before Homebrew on PATH (Codex does), so
    # `env python3` can start the macOS Python 3.9. Run this file again with
    # the first newer Python that exists.
    for name in ("python3.14", "python3.13", "python3.12", "python3.11"):
        for found in (shutil.which(name), f"/opt/homebrew/bin/{name}", f"/usr/local/bin/{name}"):
            if found and os.access(found, os.X_OK):
                os.execv(found, [found, os.path.realpath(__file__), *sys.argv[1:]])
    print(f"agent-skills needs Python 3.11 or later, and this is {sys.version.split()[0]}.", file=sys.stderr)
    sys.exit(2)

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "scripts"))

from agent_skills.cli import main  # noqa: E402

sys.exit(main())
