#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
import os
import sys

if sys.version_info < (3, 11):
    print(f"agent-skills needs Python 3.11 or later, and this is {sys.version.split()[0]}.", file=sys.stderr)
    sys.exit(2)

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "scripts"))

from agent_skills.cli import main  # noqa: E402

sys.exit(main())
